'use client';

import { useState, useEffect, useRef } from 'react';
import { ShoppingBag, Search, MessageCircle, X, ArrowRight, Phone, MapPin, Package, ChevronRight } from 'lucide-react';
import { dataService } from '@/lib/dataService';
import { Combo } from '@/lib/mockData';

export default function Home() {
  const [combos, setCombos] = useState<Combo[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedCombo, setSelectedCombo] = useState<Combo | null>(null);
  const [isClosing, setIsClosing] = useState(false);
  const [searchTerm, setSearchTerm] = useState('');
  const whatsappNumber = '59077155';

  // Refs y estados para el gesto de deslizar hacia abajo
  const touchStartY = useRef(0);
  const touchCurrentY = useRef(0);
  const [translateY, setTranslateY] = useState(0);

  useEffect(() => {
    async function loadData() {
      try {
        const fetchedCombos = await dataService.getCombos();
        setCombos(fetchedCombos);
      } catch (error) {
        console.error('Failed to load combos:', error);
      } finally {
        loading && setLoading(false);
      }
    }
    loadData();
  }, []);

  // Manejador del cierre con animación hacia abajo
  const handleClose = () => {
    setIsClosing(true);
    setTimeout(() => {
      setSelectedCombo(null);
      setIsClosing(false);
      setTranslateY(0);
    }, 300); // Duración de la animación de salida
  };

  // Gestión de gestos táctiles (Swipe down to close)
  const handleTouchStart = (e: React.TouchEvent) => {
    // Solo permitir el arrastre desde el handle o si el contenedor está arriba del todo
    const scrollContainer = e.currentTarget.querySelector('.overflow-y-auto');
    if (scrollContainer && scrollContainer.scrollTop > 0) return;

    touchStartY.current = e.touches[0].clientY;
  };

  const handleTouchMove = (e: React.TouchEvent) => {
    if (touchStartY.current === 0) return;

    const currentY = e.touches[0].clientY;
    const deltaY = currentY - touchStartY.current;

    // Solo arrastrar si es un movimiento hacia abajo
    if (deltaY > 0) {
      setTranslateY(deltaY);
    }
  };

  const handleTouchEnd = () => {
    // Si se deslizó más de 150px, se cierra de forma definitiva
    if (translateY > 150) {
      handleClose();
    } else {
      // Si no, regresa suavemente a su posición original
      setTranslateY(0);
    }
    touchStartY.current = 0;
  };

  const filteredCombos = combos.filter((combo) => {
    const term = searchTerm.toLowerCase();
    const matchCombo =
      combo.name.toLowerCase().includes(term) ||
      combo.description.toLowerCase().includes(term);
    const matchProducts = combo.products?.some(
      (p) =>
        p.name.toLowerCase().includes(term) ||
        p.description?.toLowerCase().includes(term)
    );
    return matchCombo || matchProducts;
  });

  const getWhatsAppLink = (combo: Combo) => {
    const text = encodeURIComponent(
      `¡Hola! Estoy interesado en comprar el combo: *${combo.name}* por el precio de *$${combo.price}*. ¿Tienen disponibilidad?`
    );
    return `https://wa.me/${whatsappNumber}?text=${text}`;
  };

  const getWhatsAppGeneral = () => {
    const text = encodeURIComponent(`¡Hola! Quisiera más información sobre sus combos disponibles.`);
    return `https://wa.me/${whatsappNumber}?text=${text}`;
  };

  return (
    <div
      className="min-h-screen flex flex-col"
      style={{ background: 'var(--bg)', color: 'var(--text-primary)' }}
    >
      {/* ── ESTILOS INYECTADOS ADICIONALES ─────────────────────────── */}
      <style jsx global>{`
        @keyframes slideInUp {
          from { transform: translateY(100%); }
          to { transform: translateY(0); }
        }
        @keyframes slideOutDown {
          from { transform: translateY(0); }
          to { transform: translateY(100%); }
        }
        .anim-slide-up {
          animation: slideInUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .anim-slide-down {
          animation: slideOutDown 0.25s cubic-bezier(0.7, 0, 0.84, 0) forwards;
        }
        .smooth-elastic-scroll {
          scroll-behavior: smooth;
          overscroll-behavior-y: contain;
        }
      `}</style>

      {/* ── HEADER ────────────────────────────────────────────────── */}
      <header
        className="sticky top-0 z-40 backdrop-blur-xl border-b"
        style={{
          background: 'color-mix(in srgb, var(--bg) 85%, transparent)',
          borderColor: 'var(--border)',
        }}
      >
        <div className="max-w-2xl mx-auto px-5 py-4 flex flex-col items-center justify-center gap-4 text-center">
          <div className="flex flex-col items-center gap-2">
            <div
              className="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
              style={{ background: 'var(--text-primary)' }}
            >
              <Package className="w-10 h-10" style={{ color: 'var(--bg)' }} />
            </div>
            <div className="leading-none">
              <p className="font-display font-bold text-lg tracking-tight leading-none">
                Punto E.
              </p>
              <p className="text-[10px] font-semibold uppercase tracking-widest mt-1" style={{ color: 'var(--text-muted)' }}>
                Combos & Delivery
              </p>
            </div>
          </div>
        </div>
      </header>

      {/* ── HERO ──────────────────────────────────────────────────── */}
      <section className="max-w-2xl mx-auto w-full px-5 pt-10 pb-8 flex flex-col items-center text-center">
        <div className="animate-fade-up flex flex-col items-center">
          <span
            className="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-5"
            style={{ background: 'var(--bg-muted)', color: 'var(--text-secondary)', border: '1px solid var(--border)' }}
          >
            <span className="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse" />
            Disponibles ahora
          </span>

          <h1 className="font-display text-[2.75rem] leading-[1.05] font-bold tracking-tight mb-4">
            Los mejores{' '}
            <span className="italic" style={{ color: 'var(--text-secondary)' }}>combos</span>
            <br />
            a tu puerta.
          </h1>

          <p className="text-sm leading-relaxed max-w-sm mx-auto" style={{ color: 'var(--text-secondary)' }}>
            Combos de alimentación y aseo personal. <br /> Selecciónalo, ordénalo y recíbelo.
          </p>
        </div>

        {/* Search */}
        <div className="mt-7 animate-fade-up delay-150 w-full max-w-md">
          <div
            className="flex items-center gap-3 px-4 py-3 rounded-2xl"
            style={{ background: 'var(--surface)', border: '1px solid var(--border)' }}
          >
            <Search className="w-4 h-4 flex-shrink-0" style={{ color: 'var(--text-muted)' }} />
            <input
              type="text"
              placeholder="Buscar combos o productos…"
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="flex-1 bg-transparent text-sm font-medium outline-none placeholder:font-normal"
            />
            {searchTerm && (
              <button onClick={() => setSearchTerm('')} className="flex-shrink-0">
                <X className="w-4 h-4" style={{ color: 'var(--text-muted)' }} />
              </button>
            )}
          </div>
        </div>
      </section>

      {/* ── CATALOG ───────────────────────────────────────────────── */}
      <main className="max-w-2xl mx-auto w-full px-5 pb-6 flex-1">
        <div className="flex items-center justify-between mb-5">
          <p className="text-[11px] font-bold uppercase tracking-widest" style={{ color: 'var(--text-muted)' }}>
            {searchTerm
              ? `${filteredCombos.length} resultado${filteredCombos.length !== 1 ? 's' : ''}`
              : `${filteredCombos.length} combo${filteredCombos.length !== 1 ? 's' : ''} disponible${filteredCombos.length !== 1 ? 's' : ''}`}
          </p>
        </div>

        {loading ? (
          <div className="grid grid-cols-2 gap-4">
            {[1, 2, 3, 4].map((n) => (
              <div key={n} className="animate-pulse">
                <div className="w-full aspect-[3/4] rounded-2xl mb-3" style={{ background: 'var(--bg-muted)' }} />
                <div className="h-3.5 rounded-full w-3/4 mb-2" style={{ background: 'var(--bg-muted)' }} />
                <div className="h-3 rounded-full w-1/2" style={{ background: 'var(--bg-muted)' }} />
              </div>
            ))}
          </div>
        ) : filteredCombos.length === 0 ? (
          <div className="py-24 flex flex-col items-center justify-center text-center gap-4">
            <div className="w-14 h-14 rounded-2xl flex items-center justify-center" style={{ background: 'var(--bg-muted)' }}>
              <Search className="w-5 h-5" style={{ color: 'var(--text-muted)' }} />
            </div>
            <div>
              <p className="font-semibold text-sm">Sin resultados</p>
              <p className="text-xs mt-1" style={{ color: 'var(--text-secondary)' }}>Intenta buscar con otro término.</p>
            </div>
            <button
              onClick={() => setSearchTerm('')}
              className="text-xs font-bold px-4 py-2 rounded-xl"
              style={{ background: 'var(--surface)', border: '1px solid var(--border)', color: 'var(--text-secondary)' }}
            >
              Limpiar búsqueda
            </button>
          </div>
        ) : (
          <div className="grid grid-cols-2 gap-x-4 gap-y-8">
            {filteredCombos.map((combo, i) => (
              <div
                key={combo.id}
                onClick={() => setSelectedCombo(combo)}
                className="group cursor-pointer animate-fade-up"
                style={{ animationDelay: `${i * 60}ms` }}
              >
                <div
                  className="relative w-full aspect-[3/4] rounded-[1.5rem] overflow-hidden mb-3 transition-transform duration-500 group-hover:scale-[0.98] group-active:scale-95"
                  style={{ background: 'var(--bg-muted)' }}
                >
                  {combo.image_url ? (
                    <img
                      src={combo.image_url}
                      alt={combo.name}
                      className="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <div className="w-full h-full flex items-center justify-center">
                      <ShoppingBag className="w-8 h-8" style={{ color: 'var(--text-muted)' }} />
                    </div>
                  )}

                  <div
                    className="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-black"
                    style={{ background: 'var(--badge-bg)', color: 'var(--badge-text)' }}
                  >
                    ${combo.price}
                  </div>

                  <div
                    className="absolute bottom-3 right-3 px-2.5 py-1 rounded-full text-[10px] font-bold backdrop-blur-md"
                    style={{
                      background: 'color-mix(in srgb, var(--surface) 80%, transparent)',
                      color: 'var(--text-secondary)',
                      border: '1px solid var(--border)',
                    }}
                  >
                    {combo.products?.length || 0} artíc.
                  </div>
                </div>

                <div className="px-0.5">
                  <h4 className="font-bold text-[15px] leading-snug mb-1 line-clamp-2">
                    {combo.name}
                  </h4>
                  <div className="flex items-center gap-1" style={{ color: 'var(--text-muted)' }}>
                    <p className="text-[11px] font-medium line-clamp-1 flex-1">
                      {combo.description}
                    </p>
                    <ChevronRight className="w-3 h-3 flex-shrink-0 opacity-50 group-hover:translate-x-0.5 transition-transform" />
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </main>

      {/* ── FOOTER ────────────────────────────────────────────────── */}
      <footer
        className="mt-16 border-t"
        style={{ background: 'var(--bg-muted)', borderColor: 'var(--border)' }}
      >
        {/* Top band — CTA */}
        <div
          className="border-b"
          style={{ borderColor: 'var(--border)' }}
        >
          <div className="max-w-2xl mx-auto px-5 py-8 flex flex-col items-center justify-center text-center gap-5">
            <div>
              <p className="font-display font-bold text-xl tracking-tight" style={{ color: 'var(--text-primary)' }}>
                ¿Tienes alguna consulta?
              </p>
              <p className="text-sm mt-1" style={{ color: 'var(--text-secondary)' }}>
                Escríbenos directamente por WhatsApp y te respondemos en minutos.
              </p>
            </div>
            <a
              href={getWhatsAppGeneral()}
              target="_blank"
              rel="noopener noreferrer"
              className="flex-shrink-0 inline-flex items-center gap-2 px-5 py-3 rounded-2xl text-sm font-bold transition-all active:scale-95 hover:brightness-110"
              style={{ background: '#25D366', color: '#fff' }}
            >
              <MessageCircle className="w-4 h-4" />
              Escribir por WhatsApp
            </a>
          </div>
        </div>

        {/* Middle band — Info */}
        <div
          className="border-b"
          style={{ borderColor: 'var(--border)' }}
        >
          <div className="max-w-2xl mx-auto px-5 py-8 flex flex-col items-center justify-center text-center gap-6">
            {/* Contact */}
            <div className="flex flex-col items-center">
              <p className="text-[10px] font-bold uppercase tracking-widest mb-4" style={{ color: 'var(--text-muted)' }}>
                Contacto
              </p>
              <ul className="space-y-3 flex flex-col items-center">
                <li>
                  <a
                    href={getWhatsAppGeneral()}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex items-center gap-2.5 text-xs font-medium transition-colors hover:opacity-80"
                    style={{ color: 'var(--text-secondary)' }}
                  >
                    <Phone className="w-3.5 h-3.5 flex-shrink-0" style={{ color: '#25D366' }} />
                    +53 {whatsappNumber}
                  </a>
                </li>
                <li>
                  <span
                    className="flex items-center gap-2.5 text-xs font-medium"
                    style={{ color: 'var(--text-secondary)' }}
                  >
                    <MapPin className="w-3.5 h-3.5 flex-shrink-0" style={{ color: 'var(--text-muted)' }} />
                    Holguín, Cuba
                  </span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        {/* Bottom bar (Cambio de Acceso admin por botón Wallcroft) */}
        <div className="max-w-2xl mx-auto px-5 py-5 flex flex-col items-center justify-center gap-3 text-center">
          <p className="text-[10px] font-medium" style={{ color: 'var(--text-muted)' }}>
            © {new Date().getFullYear()} Punto E. Todos los derechos reservados.
          </p>
          <div className="flex flex-col sm:flex-row items-center gap-2 mt-1">
            <span className="text-[11px] font-medium" style={{ color: 'var(--text-secondary)' }}>
              ¿Quieres un catálogo así?
            </span>
            <a
              href="https://wallcroft.dev"
              target="_blank"
              rel="noopener noreferrer"
              className="text-[10px] font-bold uppercase tracking-wider px-3 py-1.5 rounded-lg transition-all active:scale-95"
              style={{ background: 'var(--surface)', border: '1px solid var(--border)', color: 'var(--text-primary)' }}
            >
              contáctame
            </a>
          </div>
        </div>
      </footer>

      {/* ── MENÚ DE DETALLE PANTALLA COMPLETA (COLOR NEGRO SÓLIDO) ── */}
      {selectedCombo && (
        <div
          className="fixed inset-0 z-50 flex items-end justify-center"
          onTouchStart={handleTouchStart}
          onTouchMove={handleTouchMove}
          onTouchEnd={handleTouchEnd}
        >
          {/* Backdrop (Fondo semitransparente oscuro detrás del menú) */}
          <div
            className="absolute inset-0 transition-opacity duration-200"
            style={{
              background: 'rgba(0,0,0,0.7)',
              opacity: Math.max(0.2, 1 - translateY / 400)
            }}
            onClick={handleClose}
          />

          {/* Contenedor del Menú (Negro Puro) */}
          <div
            className={`relative w-full h-[100dvh] flex flex-col z-10 shadow-2xl overflow-hidden ${isClosing ? 'anim-slide-down' : 'anim-slide-up'
              }`}
            style={{
              background: '#000000', // <--- Forzado a Negro Puro Absoluto
              color: '#ffffff',      // <--- Forzamos texto blanco para que se lea perfecto
              transform: `translateY(${translateY}px)`,
              transition: translateY === 0 ? 'transform 0.3s cubic-bezier(0.16, 1, 0.3, 1)' : 'none'
            }}
          >
            {/* Barra superior fija con Drag Handle y Botón de Cerrar */}
            <div className="w-full flex-shrink-0 relative pt-3 pb-3 border-b border-zinc-800" style={{ background: '#000000' }}>
              {/* Drag Handle visual */}
              <div className="w-12 h-1.5 rounded-full mx-auto bg-zinc-700" />

              {/* Botón de Cruz */}
              <button
                onClick={handleClose}
                className="absolute right-4 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full flex items-center justify-center transition-transform active:scale-90 bg-zinc-800 text-white"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Contenido con Scroll */}
            <div className="overflow-y-auto flex-1 smooth-elastic-scroll pb-32">
              {/* Imagen Principal */}
              <div className="w-full aspect-[4/3] sm:aspect-video relative bg-zinc-900">
                {selectedCombo.image_url ? (
                  <img
                    src={selectedCombo.image_url}
                    alt={selectedCombo.name}
                    className="w-full h-full object-cover"
                  />
                ) : (
                  <div className="w-full h-full flex items-center justify-center">
                    <ShoppingBag className="w-12 h-12 text-zinc-500" />
                  </div>
                )}
              </div>

              {/* Cuerpo del Producto */}
              <div className="p-6 max-w-2xl mx-auto w-full">
                {/* Nombre y Precio */}
                <div className="flex items-start justify-between gap-4 mb-4">
                  <h3 className="font-display font-bold text-2xl leading-tight tracking-tight flex-1 text-white">
                    {selectedCombo.name}
                  </h3>
                  <span className="font-black text-2xl leading-tight flex-shrink-0 text-white">
                    ${selectedCombo.price}
                  </span>
                </div>

                {/* Descripción */}
                <p className="text-sm leading-relaxed mb-8 text-zinc-300">
                  {selectedCombo.description}
                </p>

                {/* Lista de Productos del combo */}
                <div>
                  <div className="flex items-center gap-2 mb-4">
                    <p className="text-[10px] font-bold uppercase tracking-widest text-zinc-400">
                      Contenido del combo
                    </p>
                    <div className="flex-1 h-px bg-zinc-800" />
                    <span className="text-[10px] font-bold text-zinc-400">
                      {selectedCombo.products?.length || 0} artíc.
                    </span>
                  </div>

                  {selectedCombo.products && selectedCombo.products.length > 0 ? (
                    <div className="flex flex-col gap-3">
                      {selectedCombo.products.map((product, idx) => (
                        <div
                          key={idx}
                          className="flex items-center gap-3 p-3 rounded-2xl bg-zinc-900 border border-zinc-800"
                        >
                          {/* Cantidad */}
                          <div
                            className="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 font-black text-sm"
                            style={{ background: 'var(--badge-bg)', color: 'var(--badge-text)' }}
                          >
                            {product.quantity || 1}×
                          </div>

                          {/* Miniatura */}
                          <div className="w-10 h-10 rounded-xl overflow-hidden flex-shrink-0 bg-zinc-800">
                            {product.image_url ? (
                              <img src={product.image_url} alt={product.name} className="w-full h-full object-cover" />
                            ) : (
                              <div className="w-full h-full flex items-center justify-center">
                                <ShoppingBag className="w-3.5 h-3.5 text-zinc-500" />
                              </div>
                            )}
                          </div>

                          {/* Nombre del subproducto */}
                          <div className="flex-1 min-w-0">
                            <p className="font-semibold text-sm leading-snug truncate text-white">{product.name}</p>
                            {product.description && (
                              <p className="text-[11px] mt-0.5 line-clamp-1 text-zinc-400">
                                {product.description}
                              </p>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p className="text-sm italic text-zinc-500">Contenido sorpresa.</p>
                  )}
                </div>
              </div>
            </div>

            {/* Botón de Acción Inferior Fijo */}
            <div
              className="absolute bottom-0 inset-x-0 p-5 flex justify-center border-t border-zinc-800"
              style={{ background: '#000000' }} // <--- Forzado a Negro Puro
            >
              <a
                href={getWhatsAppLink(selectedCombo)}
                target="_blank"
                rel="noopener noreferrer"
                className="w-full max-w-xl flex items-center justify-center gap-2.5 py-4 rounded-2xl font-black text-sm transition-all active:scale-[0.98] hover:brightness-110 shadow-lg"
                style={{ background: '#25D366', color: '#fff', boxShadow: '0 8px 24px rgba(37,211,102,0.3)' }}
              >
                <MessageCircle className="w-5 h-5" />
                Pedir por WhatsApp
                <ArrowRight className="w-4 h-4" />
              </a>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}